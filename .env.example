# Salin jadi .env lalu isi. Jangan commit .env — isinya rahasia.
#   copy .env.example .env

# ---- Captcha solver ----
# manual | 2captcha | capsolver | anticaptcha | capmonster | rucaptcha | azcaptcha
CAPTCHA_PROVIDER=2captcha
CAPTCHA_KEY=
# berapa kali coba ulang kalau solver salah baca
CAPTCHA_TRIES=3

# ---- Sumber email ----
# file       -> baca akun.txt, OTP diketik manual
# emailnator -> alamat dibuat otomatis, OTP dibaca otomatis
EMAIL_SOURCE=emailnator
EMAIL_COUNT=3
# alamat emailnator publik: kalau sudah dipakai orang, tukar sampai N kali
EMAIL_TRIES=3
# detik menunggu OTP masuk inbox
OTP_TIMEOUT=300

# ---- Proxy ----
# Pisah dengan koma, atau taruh satu-per-baris di proxy.txt (dua-duanya digabung).
# Tipe: http, https, socks4, socks4a, socks5, socks5h. Kosong -> koneksi langsung.
# Dipakai round-robin: satu akun = satu proxy, konsisten sepanjang alurnya.
PROXY=
# proxy publik banyak yang mati: coba proxy lain sebanyak ini
PROXY_TRIES=4
# detik per request. Pendek supaya proxy mati cepat ketahuan.
# Kosongkan untuk otomatis: 5 kalau pakai proxy, 30 kalau langsung.
TIMEOUT=5
# Emailnator jauh lebih lambat (inbox berisi butuh 5-6s), jadi
# timeout inbox dipisah. Minimum 20s.
MAIL_TIMEOUT=30

# ---- Lain-lain ----
# jumlah worker paralel untuk fase jaringan
WORKERS=6
# detik jeda antar tab checkout Stripe; kartu diisi satu-satu
TAB_DELAY=3
# saldo akun gratis. Credit di atas ini berarti kuota langganan
# sudah masuk; dipakai untuk menunggu credit setelah pembayaran.
FREE_CREDIT=200
# password untuk semua akun. Isi sendiri di .env; harus memenuhi
# syarat Azure B2C (huruf besar+kecil, angka, simbol, min 8 karakter).
PASSWORD=

# ---- Mode dump (py signup.py dump) ----
# Bikin akun dari tempmail, cek credit, simpan yang lolos ambang.
# TANPA checkout Stripe: tak ada kartu, tak ada tagihan.
# akun disimpan kalau credit >= nilai ini
DUMP_MIN_CREDIT=2000
# berhenti setelah dapat sebanyak ini akun yang lolos
DUMP_TARGET=1
# batas atas percobaan, biar tak jalan selamanya (tiap percobaan pakai captcha)
DUMP_MAX_TRIES=10
# berapa akun digarap serentak. Dipaksa 1 kalau CAPTCHA_PROVIDER=manual,
# karena jawaban captcha diketik satu-satu.
DUMP_WORKERS=3
# detik menunggu credit/plan menyusul setelah signup. Plan naik lebih dulu
# daripada credit dikreditkan, jadi membaca saldo terlalu cepat memberi 100
# (bonus akun gratis), bukan kuota sebenarnya.
DUMP_CREDIT_WAIT=25
